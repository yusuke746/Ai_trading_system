//@version=5
indicator("Lorentzian Classification - Advanced Trading Dashboard", overlay=true)

/// ========================================
// INPUTS
// ========================================
group_lorentz = "🌌 Lorentzian Parameters"
k_neighbors = input.int(4, "K Nearest Neighbors", minval=1, maxval=20, group=group_lorentz, tooltip="Number of historical patterns to consider for classification.\n\n• 3-5: Fast adaptation, more signals, higher noise\n• 7-10: Balanced performance (recommended)\n• 15-20: Stable predictions, fewer false signals\n\nMore neighbors = smoother but less responsive to new patterns")
lookback = input.int(100, "Historical Lookback", minval=50, maxval=500, group=group_lorentz, tooltip="How many bars of history to search for similar patterns.\n\n• 50-100: Recent patterns only (fast markets)\n• 200-300: Medium-term patterns (balanced)\n• 400-500: Long-term patterns (stable markets)\n\nMore history = better pattern recognition but slower adaptation")
feature_length = input.int(10, "Feature Window", minval=5, maxval=30, group=group_lorentz, tooltip="Number of bars used to create each feature vector.\n\n• 5-10: Short-term patterns (scalping/day trading)\n• 15-20: Medium patterns (swing trading)\n• 25-30: Long patterns (position trading)\n\nLonger windows capture more context but reduce sensitivity")
group_features = "📊 Feature Engineering"
use_price = input.bool(true, "Price Change Features", group=group_features, tooltip="Include normalized price change patterns.\n\nCaptures momentum, reversals, and price velocity across multiple timeframes")
use_volume = input.bool(true, "Volume Profile Features", group=group_features, tooltip="Include volume characteristics and anomalies.\n\nHelps identify institutional activity, breakouts, and volume-price divergences")
use_volatility = input.bool(true, "Volatility Features", group=group_features, tooltip="Include ATR and Bollinger Band volatility measures.\n\nDetects regime changes, breakout potential, and risk levels")
use_momentum = input.bool(true, "Momentum Features", group=group_features, tooltip="Include RSI and MACD momentum indicators.\n\nCaptures overbought/oversold conditions and trend strength")
group_signals = "🎯 Signal Generation"
prediction_horizon = input.int(5, "Prediction Horizon", minval=1, maxval=20, group=group_signals, tooltip="How many bars ahead to predict price direction.\n\n• 1-3: Scalping signals (high frequency)\n• 5-8: Day trading signals (balanced)\n• 10-20: Swing trading signals (longer term)\n\nLonger horizons = more reliable but less frequent signals")
signal_threshold = input.float(0.6, "Signal Threshold", minval=0.5, maxval=0.9, step=0.05, group=group_signals, tooltip="Minimum confidence required to generate trading signals.\n\n• 0.5-0.6: More signals, higher noise\n• 0.7-0.8: Balanced (recommended)\n• 0.85-0.9: High confidence only, fewer signals\n\nHigher threshold = fewer but more reliable signals")
smooth_predictions = input.int(3, "Prediction Smoothing", minval=1, maxval=10, group=group_signals, tooltip="EMA smoothing applied to raw predictions.\n\n• 1-2: Raw signals (experienced traders)\n• 3-5: Balanced smoothing (recommended)\n• 6-10: Heavy smoothing (conservative)\n\nMore smoothing = fewer false signals but increased lag")
group_visual = "🎨 Advanced Dashboard"
show_main_dashboard = input.bool(true, "Main Dashboard", group=group_visual, tooltip="Display primary signal dashboard with prediction, confidence, and market regime analysis")
show_performance_panel = input.bool(true, "Performance Panel", group=group_visual, tooltip="Show real-time performance metrics including win rate, streak, drawdown, and Sharpe ratio")
show_market_regime = input.bool(true, "Market Regime Analysis", group=group_visual, tooltip="Display trend strength (ADX), volatility regime, and volume analysis for context")
show_risk_metrics = input.bool(true, "Risk Metrics Panel", group=group_visual, tooltip="Show RSI, ATR%, Bollinger Band position, and MACD for risk assessment")
show_confidence_heatmap = input.bool(true, "Confidence Heatmap", group=group_visual, tooltip="Historical confidence and prediction strength visualization for pattern analysis")
dashboard_size = input.string("Normal", "Dashboard Size", options=["Small", "Normal", "Large"], group=group_visual, tooltip="Adjust dashboard text size for different screen resolutions.\n\n• Small: Compact for mobile/small screens\n• Normal: Standard desktop size\n• Large: High-resolution displays")
color_theme = input.string("Professional", "Color Theme", options=["Professional", "Neon", "Matrix", "Classic"], group=group_visual, tooltip="Visual theme for dashboard and signals.\n\n• Professional: Blue/red corporate colors\n• Neon: Bright cyan/magenta cyberpunk style\n• Matrix: Green/red hacker aesthetic\n• Classic: Traditional blue/red trading colors")

// ========================================
// FEATURE CALCULATION
// ========================================

// Price features
price_feat1 = use_price ? (close - close[1]) / close[1] : 0
price_feat2 = use_price ? (close - close[2]) / close[2] : 0
price_feat3 = use_price ? (close - close[3]) / close[3] : 0
price_feat4 = use_price ? (close - close[5]) / close[5] : 0
price_feat5 = use_price ? (close - close[8]) / close[8] : 0

// Volume features
avg_vol = ta.sma(volume, 20)
vol_feat1 = use_volume ? volume / avg_vol : 0
vol_feat2 = use_volume ? volume[1] / avg_vol : 0
vol_feat3 = use_volume ? volume[2] / avg_vol : 0

// Volatility features
atr_val = ta.atr(14)
[bb_middle, bb_upper, bb_lower] = ta.bb(close, 20, 2)
bb_width = bb_upper - bb_lower
volat_feat1 = use_volatility ? atr_val / close : 0
volat_feat2 = use_volatility ? bb_width / close : 0

// Momentum features
rsi_val = ta.rsi(close, 14)
[macd_line, signal_line, histogram] = ta.macd(close, 12, 26, 9)
mom_feat1 = use_momentum ? (rsi_val - 50) / 50 : 0
mom_feat2 = use_momentum ? macd_line / close : 0

// Normalize features
normalize_series(series, len) =>
    min_val = ta.lowest(series, len)
    max_val = ta.highest(series, len)
    range_val = max_val - min_val
    range_val > 0 ? 2 * (series - min_val) / range_val - 1 : 0.0

n_price1 = normalize_series(price_feat1, lookback)
n_price2 = normalize_series(price_feat2, lookback)
n_price3 = normalize_series(price_feat3, lookback)
n_price4 = normalize_series(price_feat4, lookback)
n_price5 = normalize_series(price_feat5, lookback)
n_vol1 = normalize_series(vol_feat1, lookback)
n_vol2 = normalize_series(vol_feat2, lookback)
n_vol3 = normalize_series(vol_feat3, lookback)
n_volat1 = normalize_series(volat_feat1, lookback)
n_volat2 = normalize_series(volat_feat2, lookback)
n_mom1 = mom_feat1
n_mom2 = normalize_series(mom_feat2, lookback)

// ========================================
// LORENTZIAN DISTANCE & PREDICTION
// ========================================

var dist_array = array.new_float(lookback, 999999)
var outcome_array = array.new_float(lookback, 0)

curr_features = array.new_float(0)
array.push(curr_features, n_price1)
array.push(curr_features, n_price2)
array.push(curr_features, n_price3)
array.push(curr_features, n_price4)
array.push(curr_features, n_price5)
array.push(curr_features, n_vol1)
array.push(curr_features, n_vol2)
array.push(curr_features, n_vol3)
array.push(curr_features, n_volat1)
array.push(curr_features, n_volat2)
array.push(curr_features, n_mom1)
array.push(curr_features, n_mom2)

weighted_sum = 0.0
total_weight = 0.0
confidence_up = 0.0
confidence_down = 0.0
neighbors_found = 0
avg_distance = 0.0

if barstate.isconfirmed and bar_index >= (lookback + prediction_horizon + 10)
    start_idx = prediction_horizon
    end_idx = math.min(lookback - 1, bar_index - prediction_horizon - 10)
    
    for i = start_idx to end_idx
        hist_features = array.new_float(0)
        array.push(hist_features, n_price1[i])
        array.push(hist_features, n_price2[i])
        array.push(hist_features, n_price3[i])
        array.push(hist_features, n_price4[i])
        array.push(hist_features, n_price5[i])
        array.push(hist_features, n_vol1[i])
        array.push(hist_features, n_vol2[i])
        array.push(hist_features, n_vol3[i])
        array.push(hist_features, n_volat1[i])
        array.push(hist_features, n_volat2[i])
        array.push(hist_features, n_mom1[i])
        array.push(hist_features, n_mom2[i])
        
        distance = 0.0
        for j = 0 to array.size(curr_features) - 1
            if j < array.size(hist_features)
                diff = array.get(curr_features, j) - array.get(hist_features, j)
                distance += math.log(1 + math.abs(diff))
        
        array.set(dist_array, i, distance)
        
        future_return = close[i - prediction_horizon] - close[i]
        outcome = future_return > 0 ? 1.0 : -1.0
        array.set(outcome_array, i, outcome)

temp_dist_array = array.copy(dist_array)

if bar_index >= (lookback + prediction_horizon + 10)
    start_idx = prediction_horizon
    end_idx = math.min(lookback - 1, bar_index - prediction_horizon - 10)
    
    for k = 0 to k_neighbors - 1
        min_dist = 999999.0
        min_idx = -1
        
        for i = start_idx to end_idx
            dist = array.get(temp_dist_array, i)
            if dist < min_dist
                min_dist := dist
                min_idx := i
        
        if min_idx >= 0 and min_dist < 999999
            weight = 1.0 / (1.0 + min_dist)
            outcome = array.get(outcome_array, min_idx)
            weighted_sum += outcome * weight
            total_weight += weight
            
            if outcome > 0
                confidence_up += weight
            else
                confidence_down += weight
            
            neighbors_found += 1
            avg_distance += min_dist
            
            array.set(temp_dist_array, min_idx, 999999)

avg_distance := neighbors_found > 0 ? avg_distance / neighbors_found : 0

raw_prediction = total_weight > 0 ? weighted_sum / total_weight : 0
prediction = ta.ema(raw_prediction, smooth_predictions)

confidence = total_weight > 0 ? math.abs(confidence_up - confidence_down) / total_weight : 0
smooth_confidence = ta.ema(confidence, smooth_predictions)

long_signal = prediction > signal_threshold and smooth_confidence > 0.5
short_signal = prediction < -signal_threshold and smooth_confidence > 0.5

// Prevent signal clustering - only show first signal in a sequence
var bool prev_long_signal = false
var bool prev_short_signal = false

// Only trigger on first occurrence
first_long_signal = long_signal and not prev_long_signal
first_short_signal = short_signal and not prev_short_signal

// Update previous state
prev_long_signal := long_signal
prev_short_signal := short_signal

// ========================================
// ENHANCED METRICS CALCULATION
// ========================================

// Performance tracking
var float total_signals = 0
var float winning_signals = 0
var float total_pnl = 0
var float max_drawdown = 0
var float peak_equity = 0
var float current_streak = 0
var bool last_signal_bull = false
var int last_signal_bar = 0
var float last_signal_price = 0

// Track signal history for proper performance calculation
var signal_history = array.new<float>(0)
var signal_types = array.new<bool>(0)
var signal_bars = array.new<int>(0)

// Market regime detection with manual ADX
calculate_adx(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    sum = plus + minus
    adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), len)
    adx

trend_strength = calculate_adx(14)
volatility_regime = ta.atr(14) / ta.sma(ta.atr(14), 50)
volume_regime = volume / ta.sma(volume, 50)

// Risk metrics
sharpe_approx = ta.sma(prediction, 20) / (ta.stdev(prediction, 20) + 0.001)
var float equity_curve = 10000
var float max_equity = 10000

// Update performance metrics when new signal occurs
if first_long_signal or first_short_signal
    total_signals += 1
    last_signal_bull := first_long_signal
    last_signal_bar := bar_index
    last_signal_price := close
    
    // Store signal for future evaluation
    array.push(signal_history, close)
    array.push(signal_types, first_long_signal)
    array.push(signal_bars, bar_index)

// Evaluate past signals that have reached their prediction horizon
if array.size(signal_bars) > 0
    for i = array.size(signal_bars) - 1 to 0
        signal_bar = array.get(signal_bars, i)
        
        // Check if enough time has passed
        if bar_index - signal_bar >= prediction_horizon
            entry_price = array.get(signal_history, i)
            is_long = array.get(signal_types, i)
            
            // Calculate actual return
            signal_return = (is_long ? close - entry_price : entry_price - close) / entry_price
            
            // Update metrics
            if signal_return > 0
                winning_signals += 1
                current_streak := current_streak >= 0 ? current_streak + 1 : 1
            else
                current_streak := current_streak <= 0 ? current_streak - 1 : -1
            
            total_pnl += signal_return
            equity_curve := equity_curve * (1 + signal_return)
            
            // Update drawdown
            max_equity := math.max(max_equity, equity_curve)
            drawdown = (max_equity - equity_curve) / max_equity
            max_drawdown := math.max(max_drawdown, drawdown)
            
            // Remove evaluated signal
            array.remove(signal_bars, i)
            array.remove(signal_history, i)
            array.remove(signal_types, i)

// Calculate win rate only from completed trades
completed_trades = total_signals - array.size(signal_bars)
win_rate = completed_trades > 0 ? winning_signals / completed_trades * 100 : 0

// Calculate average return per trade
avg_return = completed_trades > 0 ? total_pnl / completed_trades * 100 : 0

// Annualized Sharpe (approximation based on daily returns)
annual_sharpe = sharpe_approx * math.sqrt(252)

// ========================================
// COLOR THEMES
// ========================================
get_theme_colors() =>
    switch color_theme
        "Professional" => [color.new(#2962FF, 0), color.new(#FF5252, 0), color.new(#4CAF50, 0), color.new(#FF9800, 0), color.new(#9C27B0, 0)]
        "Neon" => [color.new(#00FFFF, 0), color.new(#FF00FF, 0), color.new(#00FF00, 0), color.new(#FFFF00, 0), color.new(#FF0080, 0)]
        "Matrix" => [color.new(#00FF00, 0), color.new(#FF0000, 0), color.new(#00FF80, 0), color.new(#80FF00, 0), color.new(#FF8000, 0)]
        "Classic" => [color.new(#0080FF, 0), color.new(#FF4040, 0), color.new(#40FF40, 0), color.new(#FFFF40, 0), color.new(#FF40FF, 0)]
        => [color.blue, color.red, color.green, color.orange, color.purple]

[bull_color, bear_color, success_color, warning_color, info_color] = get_theme_colors()

get_text_size() =>
    switch dashboard_size
        "Small" => size.tiny
        "Normal" => size.small
        "Large" => size.normal
        => size.small

text_size = get_text_size()

// ========================================
// MAIN DASHBOARD
// ========================================
var table main_dash = table.new(position.top_right, 3, 8, bgcolor=color.new(color.black, 85), border_color=color.new(color.gray, 70), border_width=1)

if barstate.islast and show_main_dashboard
    // Header
    table.cell(main_dash, 0, 0, "🌌 LORENTZIAN CLASSIFIER", text_color=info_color, text_size=text_size, text_halign=text.align_center, bgcolor=color.new(color.black, 70))
    table.cell(main_dash, 1, 0, "", text_color=color.white, text_size=text_size)
    table.cell(main_dash, 2, 0, "", text_color=color.white, text_size=text_size)
    
    // Signal Status
    signal_text = prediction > signal_threshold ? "🚀 LONG" : prediction < -signal_threshold ? "🔻 SHORT" : "⏸️ NEUTRAL"
    signal_color = prediction > signal_threshold ? bull_color : prediction < -signal_threshold ? bear_color : color.gray
    table.cell(main_dash, 0, 1, "Signal", text_color=color.gray, text_size=text_size)
    table.cell(main_dash, 1, 1, signal_text, text_color=signal_color, text_size=text_size, text_halign=text.align_center)
    table.cell(main_dash, 2, 1, str.tostring(prediction, "#.###"), text_color=signal_color, text_size=text_size)
    
    // Confidence with visual bar
    conf_pct = smooth_confidence * 100
    conf_bars = math.round(conf_pct / 5)
    conf_visual = ""
    for i = 1 to 20
        conf_visual := conf_visual + (i <= conf_bars ? "█" : "░")
    
    table.cell(main_dash, 0, 2, "Confidence", text_color=color.gray, text_size=text_size)
    table.cell(main_dash, 1, 2, str.tostring(conf_pct, "#.#") + "%", text_color=color.white, text_size=text_size)
    table.cell(main_dash, 2, 2, conf_visual, text_color=success_color, text_size=size.tiny, text_font_family=font.family_monospace)
    
    // Neighbors & Distance
    table.cell(main_dash, 0, 3, "Neighbors", text_color=color.gray, text_size=text_size)
    table.cell(main_dash, 1, 3, str.tostring(neighbors_found) + "/" + str.tostring(k_neighbors), text_color=color.white, text_size=text_size)
    table.cell(main_dash, 2, 3, "Dist: " + str.tostring(avg_distance, "#.##"), text_color=color.white, text_size=text_size)
    
    // Market Regime
    regime_text = trend_strength > 25 ? "TRENDING" : "RANGING"
    regime_color = trend_strength > 25 ? success_color : warning_color
    table.cell(main_dash, 0, 4, "Regime", text_color=color.gray, text_size=text_size)
    table.cell(main_dash, 1, 4, regime_text, text_color=regime_color, text_size=text_size)
    table.cell(main_dash, 2, 4, "ADX: " + str.tostring(trend_strength, "#"), text_color=color.white, text_size=text_size)
    
    // Volatility
    vol_text = volatility_regime > 1.2 ? "HIGH" : volatility_regime < 0.8 ? "LOW" : "NORMAL"
    vol_color = volatility_regime > 1.2 ? bear_color : volatility_regime < 0.8 ? bull_color : color.gray
    table.cell(main_dash, 0, 5, "Volatility", text_color=color.gray, text_size=text_size)
    table.cell(main_dash, 1, 5, vol_text, text_color=vol_color, text_size=text_size)
    table.cell(main_dash, 2, 5, str.tostring(volatility_regime, "#.##") + "x", text_color=color.white, text_size=text_size)
    
    // Volume
    vol_regime_text = volume_regime > 1.5 ? "HIGH" : volume_regime < 0.7 ? "LOW" : "NORMAL"
    vol_regime_color = volume_regime > 1.5 ? success_color : volume_regime < 0.7 ? bear_color : color.gray
    table.cell(main_dash, 0, 6, "Volume", text_color=color.gray, text_size=text_size)
    table.cell(main_dash, 1, 6, vol_regime_text, text_color=vol_regime_color, text_size=text_size)
    table.cell(main_dash, 2, 6, str.tostring(volume_regime, "#.##") + "x", text_color=color.white, text_size=text_size)
    
    // Timestamp
    table.cell(main_dash, 0, 7, "Updated", text_color=color.gray, text_size=text_size)
    table.cell(main_dash, 1, 7, str.tostring(hour) + ":" + str.tostring(minute, "00"), text_color=color.white, text_size=text_size)
    table.cell(main_dash, 2, 7, str.tostring(month, "00") + "/" + str.tostring(dayofmonth, "00"), text_color=color.white, text_size=text_size)

// ========================================
// COMBINED PERFORMANCE & RISK PANEL
// ========================================
var table combined_panel = table.new(position.bottom_right, 2, 11, bgcolor=color.new(color.black, 85), border_color=color.new(color.purple, 80), border_width=1)

if barstate.islast and (show_performance_panel or show_risk_metrics)
    // Header with Dskyz branding
    table.cell(combined_panel, 0, 0, "⚡ Dskyz (DAFE) Trading Systems", text_color=color.rgb(200, 200, 255), text_size=text_size, text_halign=text.align_center)
    table.cell(combined_panel, 1, 0, "", text_color=color.white, text_size=text_size)
    
    // Performance Section Header
    table.cell(combined_panel, 0, 1, "📊 PERFORMANCE", text_color=success_color, text_size=text_size, text_halign=text.align_center)
    table.cell(combined_panel, 1, 1, "", text_color=color.white, text_size=text_size)
    
    // Win Rate
    wr_color = win_rate > 60 ? success_color : win_rate > 45 ? warning_color : bear_color
    table.cell(combined_panel, 0, 2, "Win Rate", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 2, str.tostring(win_rate, "#.#") + "%", text_color=wr_color, text_size=text_size)
    
    // Total Signals
    table.cell(combined_panel, 0, 3, "Signals", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 3, str.tostring(total_signals, "#"), text_color=color.white, text_size=text_size)
    
    // Current Streak
    streak_color = current_streak > 0 ? success_color : current_streak < 0 ? bear_color : color.gray
    streak_text = current_streak > 0 ? "+" + str.tostring(current_streak, "#") : str.tostring(current_streak, "#")
    table.cell(combined_panel, 0, 4, "Streak", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 4, streak_text, text_color=streak_color, text_size=text_size)
    
    // Max Drawdown
    dd_color = max_drawdown > 0.15 ? bear_color : max_drawdown > 0.08 ? warning_color : success_color
    table.cell(combined_panel, 0, 5, "Max DD", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 5, str.tostring(max_drawdown * 100, "#.#") + "%", text_color=dd_color, text_size=text_size)
    
    // Sharpe Approximation
    sharpe_color = sharpe_approx > 1 ? success_color : sharpe_approx > 0 ? warning_color : bear_color
    table.cell(combined_panel, 0, 6, "Sharpe", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 6, str.tostring(sharpe_approx, "#.##"), text_color=sharpe_color, text_size=text_size)
    
    // Risk Section Header
    table.cell(combined_panel, 0, 7, "⚠️ RISK METRICS", text_color=warning_color, text_size=text_size, text_halign=text.align_center)
    table.cell(combined_panel, 1, 7, "", text_color=color.white, text_size=text_size)
    
    // RSI
    rsi_color = rsi_val > 70 ? bear_color : rsi_val < 30 ? bull_color : color.gray
    table.cell(combined_panel, 0, 8, "RSI", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 8, str.tostring(rsi_val, "#.#"), text_color=rsi_color, text_size=text_size)
    
    // ATR %
    atr_pct = (atr_val / close) * 100
    atr_color = atr_pct > 3 ? bear_color : atr_pct < 1 ? success_color : warning_color
    table.cell(combined_panel, 0, 9, "ATR %", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 9, str.tostring(atr_pct, "#.##") + "%", text_color=atr_color, text_size=text_size)
    
    // BB Position & MACD combined in last row
    bb_position = (close - bb_lower) / (bb_upper - bb_lower)
    bb_color = bb_position > 0.8 ? bear_color : bb_position < 0.2 ? bull_color : color.gray
    macd_signal = macd_line > signal_line ? "BULL" : "BEAR"
    macd_color = macd_line > signal_line ? bull_color : bear_color
    
    table.cell(combined_panel, 0, 10, "BB/MACD", text_color=color.gray, text_size=text_size)
    table.cell(combined_panel, 1, 10, str.tostring(bb_position * 100, "#") + "%/" + macd_signal, text_color=bb_color, text_size=text_size)

// ========================================
// CONFIDENCE HEATMAP
// ========================================
var table heatmap = table.new(position.bottom_left, 10, 3, bgcolor=color.new(color.black, 85), border_color=color.new(color.gray, 70), border_width=1)

if barstate.islast and show_confidence_heatmap
    // Header
    table.cell(heatmap, 0, 0, "🔥 CONFIDENCE HEATMAP", text_color=info_color, text_size=text_size, text_halign=text.align_center)
    for i = 1 to 9
        table.cell(heatmap, i, 0, "", text_color=color.white, text_size=text_size)
    
    // Historical confidence levels (last 10 periods)
    table.cell(heatmap, 0, 1, "History", text_color=color.gray, text_size=text_size)
    for i = 1 to 9
        hist_conf = smooth_confidence[10-i]
        heat_color = hist_conf > 0.7 ? color.new(success_color, 20) : hist_conf > 0.5 ? color.new(warning_color, 40) : color.new(bear_color, 60)
        table.cell(heatmap, i, 1, str.tostring(hist_conf * 100, "#"), text_color=color.white, text_size=size.tiny, bgcolor=heat_color)
    
    // Prediction strength heatmap
    table.cell(heatmap, 0, 2, "Strength", text_color=color.gray, text_size=text_size)
    for i = 1 to 9
        hist_pred = math.abs(prediction[10-i])
        pred_color = hist_pred > 0.6 ? color.new(bull_color, 20) : hist_pred > 0.3 ? color.new(warning_color, 40) : color.new(color.gray, 60)
        table.cell(heatmap, i, 2, str.tostring(hist_pred, "#.#"), text_color=color.white, text_size=size.tiny, bgcolor=pred_color)

// ========================================
// ENHANCED VISUALIZATIONS
// ========================================

// Dynamic background coloring
bg_color = prediction > signal_threshold and smooth_confidence > 0.5 ? color.new(bull_color, 90) : 
           prediction < -signal_threshold and smooth_confidence > 0.5 ? color.new(bear_color, 90) : na
bgcolor(bg_color)

// Simple signal arrows - only first occurrence
plotshape(first_long_signal, "Long Signal", shape.triangleup, location.belowbar, bull_color, size=size.small)
plotshape(first_short_signal, "Short Signal", shape.triangledown, location.abovebar, bear_color, size=size.small)

// Enhanced labels with confidence info - only first occurrence
if first_long_signal and barstate.isconfirmed
    label.new(bar_index, low * 0.999, "LONG\n" + str.tostring(smooth_confidence*100, "#") + "%", 
              color=bull_color, textcolor=color.white, style=label.style_label_up, size=size.normal)

if first_short_signal and barstate.isconfirmed
    label.new(bar_index, high * 1.001, "SHORT\n" + str.tostring(smooth_confidence*100, "#") + "%", 
              color=bear_color, textcolor=color.white, style=label.style_label_down, size=size.normal)

// Confidence ribbon
conf_high = ta.highest(high, 20) * (1 + 0.01 * smooth_confidence)
conf_low = ta.lowest(low, 20) * (1 - 0.01 * smooth_confidence)

plot(conf_high, "Confidence High", color=color.new(success_color, 80), linewidth=1)
plot(conf_low, "Confidence Low", color=color.new(success_color, 80), linewidth=1)
fill(plot(conf_high), plot(conf_low), color=color.new(success_color, 90), title="Confidence Zone")

// Prediction strength line
pred_line = close * (1 + prediction * 0.02)
plot(pred_line, "Prediction Line", color=prediction > 0 ? bull_color : bear_color, linewidth=2, style=plot.style_circles)

// ========================================
// ENHANCED ALERTS
// ========================================
alertcondition(long_signal and smooth_confidence > 0.7, "High Confidence Long", "HIGH CONFIDENCE LONG SIGNAL")
alertcondition(short_signal and smooth_confidence > 0.7, "High Confidence Short", "HIGH CONFIDENCE SHORT SIGNAL")
alertcondition(smooth_confidence > 0.85, "Extreme Confidence", "EXTREME CONFIDENCE DETECTED")
alertcondition(win_rate > 70 and total_signals > 10, "High Performance", "HIGH PERFORMANCE ACHIEVED")

// --- Watermark 
var table watermarkTable = na
if na(watermarkTable)
    watermarkTable := table.new(position.bottom_center, 1, 1, bgcolor=color.new(color.black, 90), border_color=color.new(color.purple, 80), border_width=1)
table.clear(watermarkTable, 0, 0)
table.cell(watermarkTable, 0, 0, "⚡ Dskyz (DAFE) Trading Systems", text_color=color.rgb(200, 200, 255), text_size=size.normal)